# EpochDB Distributed Server Cluster Configuration

# Node Mode: "shard" (storage node) or "coordinator" (gateway router)
NODE_MODE=shard

# Shard gateway URL list (comma-separated list, required in coordinator mode)
SHARD_NODES=http://shard0:8080,http://shard1:8080,http://shard2:8080

# Client API key for coordinator gateway authorization
API_KEY=test-api-key-12345

# Internal auth token for inter-node shard security
INTERNAL_AUTH_TOKEN=test-internal-token-67890

# Local SQLite / Parquet database persistent storage directory
STORAGE_DIR=./shared_memory

# Embedding Model Configuration (passed to database shard nodes)
# Options:
#   - jersobh/epochdb-embed (EMBEDDING_DIM=384, fine-tuned lightweight semantic embedding)
#   - all-MiniLM-L6-v2 (EMBEDDING_DIM=384, ~22M params, ultra-fast CPU/GPU default)
#   - Providers: "openai:<model>", "google:<model>", "ollama:<model>", or HuggingFace local models
EMBEDDING_MODEL=jersobh/epochdb-embed
EMBEDDING_DIM=384
GRAPH_HUB_LIMIT=12
GRAPH_HUB_CONCURRENCY=4

# Pre-warm app partition at shard boot (matches X-Tenant / X-Namespace)
DEFAULT_TENANT=global
DEFAULT_NAMESPACE=default

# Coordinator tuning under MiniLM CPU load
COORDINATOR_HTTP_TIMEOUT=120
COORDINATOR_GRAPH_TIMEOUT=25
COORDINATOR_STATS_TIMEOUT=8
COORDINATOR_POLL_INTERVAL=5
COORDINATOR_MAX_BACKOFF=60

# Gunicorn (workers must stay 1 — EpochDB FileLock is exclusive per STORAGE_DIR)
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=180

# Triple extraction:
#   - local (fast heuristic word co-occurrence, 0ms latency)
#   - hf:jersobh/epochdb-extractor-0.8b (fine-tuned Qwen3.5-0.8B for structured knowledge triples)
#   - hf:Babelscape/rebel-large | google:gemini-2.5-flash | openai:gpt-4o-mini
EPOCHDB_EXTRACTION_MODEL=jersobh/epochdb-extractor

# API Keys for Cloud Embedding Providers (optional; not needed for local MiniLM + local extract)
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
